{
  "opencollection": "1.0.0",
  "info": {
    "name": "AirLabs Aviation Data Airlines Suggest API",
    "version": "v9"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Suggest",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Autocomplete / search suggestions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://airlabs.co/api/v9/suggest",
            "params": [
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search query (min 2 chars)"
              },
              {
                "name": "_fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of response fields to return"
              },
              {
                "name": "_limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              }
            ]
          },
          "docs": "Returns matching airports, cities, and airlines for a search query. Minimum query length is 2 characters."
        }
      ]
    }
  ],
  "bundled": true
}