{
  "opencollection": "1.0.0",
  "info": {
    "name": "AirLabs Aviation Data Airlines Cities API",
    "version": "v9"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cities database",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://airlabs.co/api/v9/cities",
            "params": [
              {
                "name": "city_code",
                "value": "",
                "type": "query",
                "description": "City IATA code"
              },
              {
                "name": "country_code",
                "value": "",
                "type": "query",
                "description": "Country ISO 2 code"
              },
              {
                "name": "_fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of response fields to return"
              },
              {
                "name": "_limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              }
            ]
          },
          "docs": "Returns cities from the database."
        }
      ]
    }
  ],
  "bundled": true
}