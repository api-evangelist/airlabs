{
  "opencollection": "1.0.0",
  "info": {
    "name": "AirLabs Aviation Data Airlines Flight API",
    "version": "v9"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Flight",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Single flight info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://airlabs.co/api/v9/flight",
            "params": [
              {
                "name": "flight_iata",
                "value": "",
                "type": "query",
                "description": "Flight IATA code"
              },
              {
                "name": "flight_icao",
                "value": "",
                "type": "query",
                "description": "Flight ICAO code"
              }
            ]
          },
          "docs": "Returns detailed information about a single flight. One of flight_iata or flight_icao is required."
        }
      ]
    }
  ],
  "bundled": true
}